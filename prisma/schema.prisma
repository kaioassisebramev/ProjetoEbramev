// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

// ========================================
// USUÁRIOS (mantém compatibilidade com NextAuth)
// ========================================
model User {
  id                String   @id @default(uuid())
  name              String
  username          String   @unique
  password          String
  role              String   @default("ADMINISTRATIVE")
  mustChangePassword Boolean @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("users")
}

// ========================================
// ENUM: TIPO DE RECEBIMENTO
// ========================================
enum TipoRecebimento {
  FISICO
  EMAIL
  WHATSAPP
}

// ========================================
// NOTAS FISCAIS
// ========================================
model NotaFiscal {
  codigo          Int              @id @default(autoincrement())
  filial          Int              // 1 ou 2
  empresa         String
  cnpj            String
  dataEmissao     DateTime
  dataVencimento  DateTime
  recebimento     TipoRecebimento
  pago            Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relacionamentos
  itens           ItemNota[]
  arquivos        Arquivo[]

  @@map("notas_fiscais")
}

// ========================================
// ITENS DA NOTA
// ========================================
model ItemNota {
  id              Int      @id @default(autoincrement())
  descricao       String
  unidadeMedida   String   // UN, KG, etc.
  quantidade      Decimal  @db.Decimal(10, 2)
  valorUnitario   Decimal  @db.Decimal(10, 2)
  valorTotal      Decimal  @db.Decimal(12, 2)
  ncm             String?
  icms            String?
  categoria       String?
  notaFiscalId    Int

  notaFiscal      NotaFiscal @relation(fields: [notaFiscalId], references: [codigo], onDelete: Cascade)

  @@map("itens_nota")
}

// ========================================
// ARQUIVOS PDF
// ========================================
model Arquivo {
  id            Int      @id @default(autoincrement())
  nomeArquivo   String
  caminhoUrl    String
  tipo          String   // MIME type
  tamanho       Int      // bytes
  notaFiscalId  Int
  createdAt     DateTime @default(now())

  notaFiscal    NotaFiscal @relation(fields: [notaFiscalId], references: [codigo], onDelete: Cascade)

  @@map("arquivos")
}

// ========================================
// UNIDADES DE MEDIDA
// ========================================
model UnidadeMedida {
  id        Int      @id @default(autoincrement())
  sigla     String   @unique
  descricao String?
  createdAt DateTime @default(now())

  @@map("unidades_medida")
}
